AGENT_API_TOKEN=dev-local-token
HOST=127.0.0.1
PORT=4317
VITE_AGENT_API_URL=http://localhost:4317

APP_API_HOST=127.0.0.1
APP_API_PORT=6172
APP_ALLOWED_ORIGINS=http://localhost:6173,http://127.0.0.1:6173
APP_URL=http://localhost:6173

PROJECT_ID=local_demo_app
SCENARIO_ID=task_filter_completed
WORKSPACE_ROOT=.
AGENT_MASTER_KEY_FILE=$HOME/.ai-test-officer/master-key

# Formal benchmark: IDs of credentials created through the admin API.
BENCHMARK_SOPHNET_CREDENTIAL_ID=
BENCHMARK_EXPERIMENT_ID=
# Run only the command and deterministic-plan baselines, without invoking an LLM.
BENCHMARK_SKIP_LLM=0
# Set only in the evaluator process, never in Agent/API/worker containers.
BENCHMARK_LABELS_ROOT=

# Production control plane (required when NODE_ENV=production).
DATABASE_URL=
REDIS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=ai-test-officer-api
OIDC_JWKS_URL=
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ENDPOINT=
