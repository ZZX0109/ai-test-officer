AGENT_API_TOKEN=dev-local-token
HOST=127.0.0.1
PORT=4317
VITE_AGENT_API_URL=http://localhost:4317

APP_API_HOST=127.0.0.1
APP_API_PORT=6172
APP_ALLOWED_ORIGINS=http://localhost:6173,http://127.0.0.1:6173
APP_URL=http://localhost:6173

PROJECT_ID=local_demo_app
SCENARIO_ID=task_filter_completed
WORKSPACE_ROOT=.
AGENT_MASTER_KEY_FILE=$HOME/.ai-test-officer/master-key

# Optional external-project roots used only by the corresponding smoke or
# benchmark profile. Keeping them out of JSON manifests makes the repository
# portable across machines; a missing root fails closed at project start.
ANDFLOW_PROJECT_ROOT=
PSYEXPGEN_PROJECT_ROOT=
INVESTMENT_AGENT_PROJECT_ROOT=
E2E_FASTAPI_PROJECT_ROOT=
E2E_GO_PROJECT_ROOT=
E2E_STATIC_PROJECT_ROOT=
E2E_VITE_PROJECT_ROOT=

# Formal benchmark: IDs of credentials created through the admin API.
BENCHMARK_SOPHNET_CREDENTIAL_ID=
BENCHMARK_EXPERIMENT_ID=
# Run only the command and deterministic-plan baselines, without invoking an LLM.
BENCHMARK_SKIP_LLM=0
# Set only in the evaluator process, never in Agent/API/worker containers.
BENCHMARK_LABELS_ROOT=

# Production control plane (required when NODE_ENV=production).
DATABASE_URL=
DATABASE_APPLICATION_NAME=ai-test-officer
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
DATABASE_POOL_MAX_USES=0
REDIS_URL=
OUTBOX_POLL_INTERVAL_MS=5000
OIDC_ISSUER=
OIDC_AUDIENCE=ai-test-officer-api
OIDC_JWKS_URL=
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_FORCE_PATH_STYLE=0
# Worker-side object metadata reconciliation; unreferenced objects are only
# removed after its conservative grace windows.
ARTIFACT_RECONCILE_INTERVAL_MS=900000
# Scan abandoned active Runs and write a fresh versioned Outbox delivery after
# their execution lease expires. The default follows the 30s lease TTL.
EXECUTION_LEASE_RECOVERY_INTERVAL_MS=10000
# A persisted Gate may outlive the short Worker Job that advanced the graph.
# Only recover a `judging` Run after this grace period, never by re-executing
# its path.
JUDGING_RECOVERY_GRACE_MS=120000
# 已提交计划审批、但 Graph 尚未跨过 plan-approval checkpoint 时的恢复宽限期（毫秒）
PLAN_APPROVAL_RESUME_RECOVERY_GRACE_MS=120000

# OCI non-deny runs require an operator-provisioned egress-only network and
# an allowlist-aware proxy. The worker fails closed when either is absent.
ATO_EGRESS_NETWORK_NAME=ato-egress-production
ATO_EGRESS_PROXY_URL=http://egress-proxy.internal:3128
ATO_EGRESS_PROXY_CONTAINER_NAME=ato-egress-proxy
ATO_EGRESS_POLICY_SECRET=replace-with-a-random-shared-secret

# Recoverable Agent orchestration and repair sandbox.
AGENT_ORCHESTRATION_MODE=active
# When mode=active, keep non-listed projects on the shadow/legacy path during
# staged rollout. Empty means all projects use active mode.
# Optional emergency comparison allowlist (ignored unless explicitly handled by tooling).
AGENT_GRAPH_ACTIVE_PROJECTS=
LANGGRAPH_POSTGRES_SCHEMA=langgraph
REPAIR_SANDBOX_ENABLED=true
# Keep disabled in shared/production deployments. Enabling this only exposes
# an explicit, hash-checked maintainer action; it never permits silent writes.
REPAIR_HOST_APPLY_ENABLED=false
# Production RunEvidenceManifest signing uses an Ed25519 deployment keypair.
# Inject PEM values through a Secret manager; never commit either value.
RUN_EVIDENCE_ED25519_PRIVATE_KEY=
RUN_EVIDENCE_ED25519_PUBLIC_KEY=
RUN_EVIDENCE_SIGNING_KEY_ID=deployment-ed25519
