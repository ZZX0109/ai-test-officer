FROM mcr.microsoft.com/playwright:v1.61.1-noble AS build
ARG VITE_AGENT_URL=http://localhost:14317
ARG VITE_OIDC_ISSUER=http://localhost:18080/realms/ai-test-officer
ARG VITE_OIDC_CLIENT_ID=ai-test-officer-local
ENV VITE_AGENT_URL=$VITE_AGENT_URL VITE_OIDC_ISSUER=$VITE_OIDC_ISSUER VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID
WORKDIR /app
COPY --chown=pwuser:pwuser package.json package-lock.json ./
COPY --chown=pwuser:pwuser agent/package.json agent/package.json
COPY --chown=pwuser:pwuser app-under-test/package.json app-under-test/package.json
COPY --chown=pwuser:pwuser workbench-ui/package.json workbench-ui/package.json
COPY --chown=pwuser:pwuser packages packages
# Registry connections may be reset during a large Playwright image build.
# Reuse the BuildKit cache and retry only transient fetches; integrity or
# lockfile failures still fail immediately.
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci \
      --fetch-retries=5 \
      --fetch-retry-factor=2 \
      --fetch-retry-mintimeout=1000 \
      --fetch-retry-maxtimeout=20000
COPY --chown=pwuser:pwuser . .
RUN npm run build

# Target fixtures intentionally live in a separate image target. The Agent API,
# worker and Workbench image must not contain target-side variant semantics.
FROM build AS benchmark-target
USER pwuser
ENV NODE_ENV=production HOST=0.0.0.0

FROM build AS production-agent
RUN rm -rf /app/fixtures /app/evaluation
USER pwuser
ENV NODE_ENV=production HOST=0.0.0.0
CMD ["node", "agent/dist/server.js"]
