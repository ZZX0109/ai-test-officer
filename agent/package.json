{
  "name": "@ai-test-officer/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_ENV=development HOST=127.0.0.1 tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx tests/runTests.ts",
    "start": "node dist/server.js",
    "test:visual": "tsx src/manualRun.ts",
    "test:compiled-plan": "HEADLESS=1 tsx tests/compiledPlanBrowserSmoke.ts",
    "commit-check": "tsx src/commitCheckCli.ts",
    "commit-check:strict": "STRICT_RELEASE_GATE=1 tsx src/commitCheckCli.ts",
    "requirement-acceptance": "tsx src/requirementAcceptanceCli.ts",
    "patrol": "tsx src/patrolCli.ts",
    "demo:verify": "tsx src/demoVerifier.ts",
    "judge:eval": "tsx src/judgeEval.ts",
    "judge:repeat": "tsx src/judgeRepeatEval.ts",
    "worker": "tsx src/workerCli.ts",
    "migrate": "node-pg-migrate -m migrations up",
    "contracts:openapi": "tsx src/generateOpenApi.ts",
    "benchmark:run": "tsx src/benchmarkRunner.ts",
    "benchmark:evaluate": "tsx src/benchmarkExperimentCli.ts"
  },
  "dependencies": {
    "@ai-test-officer/contracts": "0.2.0",
    "@ai-test-officer/desktop-runtime": "0.2.0",
    "@ai-test-officer/execution-worker": "0.2.0",
    "@ai-test-officer/playwright-runtime": "0.2.0",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@aws-sdk/client-s3": "^3.1086.0",
    "bullmq": "^5.80.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jose": "^6.2.3",
    "pg": "^8.22.0",
    "playwright": "^1.45.3",
    "typescript": "^5.9.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.20.0",
    "node-pg-migrate": "^8.0.4",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.16.2"
  }
}
