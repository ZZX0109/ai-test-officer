{
  "name": "@ai-test-officer/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ../scripts/run-with-supported-node.mjs dev:internal",
    "dev:internal": "NODE_ENV=development HOST=127.0.0.1 tsx watch --exclude \"../workbench-ui/**\" --exclude \"../data/**\" --exclude \"../reports/**\" --exclude \"**/dist/**\" --exclude \"../packages/**\" src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../scripts/run-with-supported-node.mjs test:internal",
    "test:internal": "NODE_ENV=test tsx tests/runTests.ts",
    "start": "node ../scripts/run-with-supported-node.mjs start:internal",
    "start:internal": "node dist/server.js",
    "test:visual": "node ../scripts/run-with-supported-node.mjs test:visual:internal",
    "test:visual:internal": "tsx src/manualRun.ts",
    "test:compiled-plan": "node ../scripts/run-with-supported-node.mjs test:compiled-plan:internal",
    "test:compiled-plan:internal": "HEADLESS=1 tsx tests/compiledPlanBrowserSmoke.ts",
    "test:browser-smoke": "node ../scripts/run-with-supported-node.mjs test:browser-smoke:internal",
    "test:browser-smoke:internal": "HEADLESS=1 tsx tests/browserExecutionSmoke.ts",
    "test:andflow-login": "node ../scripts/run-with-supported-node.mjs test:andflow-login:internal",
    "test:andflow-login:internal": "HEADLESS=1 tsx tests/andflowLoginSmoke.ts",
    "test:credibility-browser": "node ../scripts/run-with-supported-node.mjs test:credibility-browser:internal",
    "test:credibility-browser:internal": "HEADLESS=1 PLAYWRIGHT_ACTION_TIMEOUT_MS=1000 tsx tests/credibilityBrowserSmoke.ts",
    "commit-check": "node ../scripts/run-with-supported-node.mjs commit-check:internal",
    "commit-check:internal": "tsx src/commitCheckCli.ts",
    "commit-check:strict": "node ../scripts/run-with-supported-node.mjs commit-check:strict:internal",
    "commit-check:strict:internal": "STRICT_RELEASE_GATE=1 tsx src/commitCheckCli.ts",
    "requirement-acceptance": "node ../scripts/run-with-supported-node.mjs requirement-acceptance:internal",
    "requirement-acceptance:internal": "tsx src/requirementAcceptanceCli.ts",
    "patrol": "node ../scripts/run-with-supported-node.mjs patrol:internal",
    "patrol:internal": "tsx src/patrolCli.ts",
    "demo:verify": "node ../scripts/run-with-supported-node.mjs demo:verify:internal",
    "demo:verify:internal": "tsx src/demoVerifier.ts",
    "judge:eval": "node ../scripts/run-with-supported-node.mjs judge:eval:internal",
    "judge:eval:internal": "tsx src/judgeEval.ts",
    "judge:repeat": "node ../scripts/run-with-supported-node.mjs judge:repeat:internal",
    "judge:repeat:internal": "tsx src/judgeRepeatEval.ts",
    "worker": "node ../scripts/run-with-supported-node.mjs worker:internal",
    "worker:internal": "tsx src/workerCli.ts",
    "migrate": "node-pg-migrate -m migrations up",
    "contracts:openapi": "tsx src/generateOpenApi.ts",
    "benchmark:run": "tsx src/benchmarkRunner.ts",
    "benchmark:evaluate": "tsx src/benchmarkExperimentCli.ts",
    "benchmark:recompute-history": "tsx src/benchmarkHistoricalRecomputeCli.ts"
  },
  "dependencies": {
    "@ai-test-officer/contracts": "0.2.0",
    "@ai-test-officer/agent-orchestration": "0.1.0",
    "@ai-test-officer/desktop-runtime": "0.2.0",
    "@ai-test-officer/execution-worker": "0.2.0",
    "@ai-test-officer/playwright-runtime": "0.2.0",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@aws-sdk/client-s3": "^3.1086.0",
    "bullmq": "^5.80.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jose": "^6.2.3",
    "pg": "^8.22.0",
    "playwright": "^1.45.3",
    "typescript": "^5.9.3",
    "fflate": "^0.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.20.0",
    "node-pg-migrate": "^8.0.4",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.16.2"
  }
}
