{
  "name": "app-under-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:api": "tsx server/mockServer.ts",
    "dev:web": "VITE_TASK_FILTER_FIXTURE_BUG=1 VITE_APP_API_URL=http://localhost:6172 vite --host 0.0.0.0 --port 6173 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx tests/appContract.test.ts",
    "preview": "VITE_TASK_FILTER_FIXTURE_BUG=1 VITE_APP_API_URL=http://localhost:6172 vite preview --port 6173 --strictPort"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.16.2",
    "typescript": "^5.8.3",
    "vite": "^7.1.0"
  }
}
