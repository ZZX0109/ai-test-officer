{
  "id": "spring-petclinic",
  "name": "Spring Petclinic",
  "projectPath": "/tmp/external-projects/spring-petclinic",
  "framework": "java-spring",
  "login": { "method": "none" },
  "processes": [],
  "env": {},
  "manifest": {
