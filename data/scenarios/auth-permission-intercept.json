    "oracles": [
      {
        "id": "permission_intercept_dom",
        "name": "访客态展示权限拦截",
        "type": "dom_text",
        "locator": "[data-testid='permission-state']",
        "expectedTextIncludes": "请先登录测试账号",
        "expected": "退出登录后页面展示请先登录测试账号"
      }
    ]
  },
  "regressionPath": {
    "stepId": "auth_relogin_regression",
    "title": "继续执行登录成功回归路径",
