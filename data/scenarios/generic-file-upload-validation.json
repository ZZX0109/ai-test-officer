    "capabilities": ["file_upload", "playwright_mcp", "artifact_evidence"]
  },
  "smoke": {
    "pathId": "open_customer_portal",
    "stepId": "open_customer_portal",
    "title": "打开客户门户",
    "headingName": "Customer Portal Lite",
    "assertionName": "客户门户标题可见",
    "expected": "Customer Portal Lite 标题出现"
  },
  "corePath": {
    "pathId": "file_upload_validation_path",
    "stepId": "upload_invoice_attachment",
    "title": "上传附件并验证页面反馈",
    "action": "file_upload_validate",
    "inputLabel": "上传附件",
    "submitButtonName": "确认上传",
    "targetLocator": "[data-testid='upload-state']",
    "expectedTextIncludes": "invoice-fixture.txt",
    "domAssertionName": "附件上传后展示文件名",
    "riskReason": "上传流程需要验证 input、文件名反馈和证据归档。",
    "oracles": [
      {
        "id": "file_upload_state",
        "name": "附件上传后展示文件名",
        "type": "file_upload_state",
        "locator": "[data-testid='upload-state']",
        "expectedTextIncludes": "invoice-fixture.txt",
        "expected": "上传附件后页面展示 invoice-fixture.txt"
      }
    ]
  },
  "regressionPath": {
    "stepId": "upload_regression_snapshot",
    "title": "保留上传回归截图",
    "action": "visual_check"
  }
