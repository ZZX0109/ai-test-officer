    "domAssertionName": "页面只展示 completed 任务",
    "riskReason": "diff 修改了筛选请求逻辑",
    "oracles": [
      {
        "id": "completed_filter_query",
        "name": "已完成筛选请求携带 status=completed",
        "type": "network_query",
        "networkUrlIncludes": "/api/tasks",
        "expectedQueryFragment": "status=completed",
        "expected": "GET /api/tasks?status=completed"
      },
      {
        "id": "completed_filter_dom",
        "name": "页面只展示 completed 任务",
        "type": "dom_all_text",
        "locator": "[data-testid='task-status']",
        "expectedStatusText": "completed",
        "expected": "列表中所有任务状态均为 completed"
      }
    ]
  },
  "regressionPath": {
    "stepId": "all_filter_regression",
    "title": "继续执行全部筛选回归路径",
