{
  "name": "ai-test-officer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/contracts",
    "packages/playwright-runtime",
    "packages/desktop-runtime",
    "packages/execution-worker",
    "packages/agent-orchestration",
    "agent",
    "app-under-test",
    "workbench-ui"
  ],
  "scripts": {
    "dev": "node scripts/run-with-supported-node.mjs dev:internal",
    "dev:internal": "node scripts/dev-supervisor.mjs",
    "dev:all": "npm run dev",
    "dev:background": "node scripts/start-dev-services.mjs",
    "stop:dev": "node scripts/stop-dev-services.mjs",
    "health:check": "node scripts/dev-service-health.mjs",
    "dev:agent": "npm --workspace @ai-test-officer/agent run dev",
    "dev:app": "npm --workspace app-under-test run dev",
    "dev:workbench": "npm --workspace workbench-ui run dev",
    "build:packages": "npm --workspace @ai-test-officer/contracts run build && npm --workspace @ai-test-officer/playwright-runtime run build && npm --workspace @ai-test-officer/desktop-runtime run build && npm --workspace @ai-test-officer/execution-worker run build && npm --workspace @ai-test-officer/agent-orchestration run build",
    "contracts:generate": "npm --workspace @ai-test-officer/agent run contracts:openapi && openapi-typescript docs/openapi.json -o workbench-ui/src/generated/api.ts && node scripts/generate-pydantic-client.mjs",
    "build": "node scripts/run-with-supported-node.mjs build:internal",
    "build:internal": "npm run build:packages && npm --workspace @ai-test-officer/agent run build && npm --workspace app-under-test run build && npm --workspace workbench-ui run build",
    "typecheck": "node scripts/run-with-supported-node.mjs typecheck:internal",
    "typecheck:internal": "npm run build:packages && npm --workspaces --if-present run typecheck",
    "test": "node scripts/run-with-supported-node.mjs test:internal",
    "test:internal": "npm run build:packages && npm --workspaces --if-present run test",
    "test:visual": "npm --workspace @ai-test-officer/agent run test:visual",
    "test:credibility-browser": "npm --workspace @ai-test-officer/agent run test:credibility-browser",
    "commit-check": "npm --workspace @ai-test-officer/agent run commit-check",
    "commit-check:strict": "npm --workspace @ai-test-officer/agent run commit-check:strict",
    "requirement-acceptance": "npm --workspace @ai-test-officer/agent run requirement-acceptance",
    "patrol": "npm --workspace @ai-test-officer/agent run patrol",
    "demo:verify": "npm --workspace @ai-test-officer/agent run demo:verify",
    "test:unified-run": "node scripts/unified-run-smoke.mjs",
    "init:local-config": "node scripts/init-local-config.mjs",
    "judge:eval": "npm --workspace @ai-test-officer/agent run judge:eval",
    "benchmark:run": "npm --workspace @ai-test-officer/agent run benchmark:run",
    "benchmark:evaluate": "npm --workspace @ai-test-officer/agent run benchmark:evaluate",
    "benchmark:recompute-history": "npm --workspace @ai-test-officer/agent run benchmark:recompute-history",
    "acceptance:production": "node scripts/production-acceptance.mjs",
    "acceptance:lock:verify": "node scripts/verify-acceptance-lock.mjs",
    "hooks:install": "sh scripts/install-ai-test-officer-hook.sh",
    "reports:retention": "node scripts/reports-retention.mjs",
    "test:retention": "node scripts/reports-retention.test.mjs",
    "reports:retention:apply": "node scripts/reports-retention.mjs --apply",
    "reports:retention:archive": "node scripts/reports-retention.mjs --apply --archive",
    "reports:retention:archive-local": "node scripts/reports-retention.mjs --apply --archive --prune-local-stores",
    "lint": "eslint \"agent/src/**/*.ts\" \"packages/*/src/**/*.ts\" \"workbench-ui/src/**/*.{ts,tsx}\" \"app-under-test/src/**/*.{ts,tsx}\"",
    "quality:contracts": "node scripts/quality-contract.mjs",
    "test:workbench-e2e": "node scripts/workbench-e2e.mjs",
    "quality": "npm run lint && npm run quality:contracts && npm run typecheck && npm test",
    "clean": "rm -rf agent/dist app-under-test/dist workbench-ui/dist"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0"
  }
}
